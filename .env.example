# ===== Slot1 · Gerência MikroTik — variáveis de ambiente (exemplo, sem segredos reais) =====
# Copie para .env e ajuste. Nunca versione o .env.

# --- Banco (Docker Compose) ---
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Fora do Docker, informe a URL completa:
# DATABASE_URL=postgres://mikrotik:SENHA@localhost:5432/mikrotik

# --- Chave mestra que cifra as credenciais dos roteadores (AES-256-GCM) ---
# Fica FORA do banco. No Docker vem de secrets/master_key (MASTER_KEY_FILE).
# Fora do Docker, use uma das opções:
# MASTER_KEY_FILE=/etc/slot1-mikrotik/master_key
# MASTER_KEY=base64-de-32-bytes   (gere com: npm --prefix backend run gen-key)
# ATENÇÃO: perder a chave = recadastrar as senhas de todos os roteadores.

# --- HTTP ---
WEB_PORT=8080
# true quando acessado por HTTPS (produção atrás do Nginx com TLS)
COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Conexão com os roteadores ---
ROS_CONNECT_TIMEOUT_MS=5000
ROS_COMMAND_TIMEOUT_MS=15000
# Conexões simultâneas: total e por equipamento
ROS_MAX_CONCURRENT=10
ROS_PER_DEVICE_CONCURRENT=2

# --- Coleta e cache ---
COLLECTOR_ENABLED=true
# Sistema + PPPoE de cada equipamento (a interface também se atualiza a cada 60 s)
POLL_INTERVAL_SEC=60
# Peers da MikroTik central
WG_POLL_INTERVAL_SEC=60
# Validade do cache das abas consultadas sob demanda
CACHE_TTL_SEC=60
# Handshake mais antigo que isso = "sem handshake recente"
WG_HANDSHAKE_STALE_SEC=180

# --- WhatsApp (WPPConnect Server, perfil "whatsapp" do Compose) ---
# Chave do servidor WPPConnect; informe a mesma na tela Notificações (fica cifrada no banco).
WPP_SECRET_KEY=troque-por-uma-chave-aleatoria
# Fixe uma versão testada em produção (ex.: 2.10.18); "latest" por padrão.
WPP_SERVER_TAG=latest
# Fuso usado nas mensagens
DISPLAY_TZ=America/Sao_Paulo

LOG_LEVEL=info
