{
  "name": "slot1-mikrotik-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/db/migrations',{recursive:true});for(const f of fs.readdirSync('src/db/migrations'))fs.copyFileSync('src/db/migrations/'+f,'dist/db/migrations/'+f)\"",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/cli/create-admin.ts",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:db": "tsx scripts/dev-db.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@electric-sql/pglite-socket": "^0.0.15",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
